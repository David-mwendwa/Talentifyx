NODE_ENV=development
PORT=5004
MONGO_URI=mongodb://localhost:27017/talentifyx
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173

# Job sync: the API re-ingests when data is older than this, checked hourly and
# on boot. Set AUTO_SYNC=off to disable and run `npm run ingest` yourself.
SYNC_INTERVAL_HOURS=12
AUTO_SYNC=on
